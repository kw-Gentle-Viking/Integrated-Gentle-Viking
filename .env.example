# AI_Gentle_Viking_RE 프로젝트 전용 자격증명 템플릿
# 실제 키 값은 .env 파일을 따로 만들어 채우세요 (.env는 .gitignore에 등록되어 커밋되지 않습니다).
# 사용법: cp .env.example .env 후 값 채우기 -> set -a && source .env && set +a (스크립트 실행 전에 매번)

# --- DB (stock_db_v2, 운영 stock_db와 계정만 공유) ---
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
STOCK_DB_V2_DSN=

# --- KIS(한국투자증권) API ---
KIS_APP_KEY=
KIS_APP_SECRET=

# --- KRX Open API(data-dbg.krx.co.kr) 인증키 ---
KRX_API_KEY=

# --- DART(전자공시) API ---
DART_API_KEY=

# --- 토스증권 Open API ---
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# --- 실험 트래킹(W&B) ---
WANDB_API_KEY=

# --- 예비 등록 ---
HF_API_KEY=

# --- 로컬 AI->백엔드 push 연동 ---
# 백엔드(Back-Gentle-Viking)가 같은 머신 8000 포트에서 로컬로 기동 중일 때의 베이스 URL.
BACKEND_WEBHOOK_URL=http://localhost:8000
# Back-Gentle-Viking/.env 의 AI_SERVER_API_KEY 와 반드시 동일한 값 (POST /ai/realtime, /ai/callback, /ai/warmup 인증)
AI_SERVER_API_KEY=

# --- 확정 모델 버전 (README.md 참고) ---
# TFT_MODEL_PATH 미설정 시 serving/model.py 기본값(serving/best_model_state_dict.pt)을 쓰므로
# 생략 가능 -- 체크포인트는 이미 그 경로에 있어야 함. 버전 식별용으로만 명시.
TFT_MODEL_VERSION=

# 운영 DB 달력(휴장일 기준). 없으면 휴장일 판단이 평일 기준으로 떨어진다.
PROD_STOCK_DB_DSN=
