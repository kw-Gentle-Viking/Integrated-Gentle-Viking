# External API keys
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GEMINI_API_KEY=
DART_API_KEY=
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACC_NO=

# Local app database
APP_DATABASE_URL=sqlite:///./app.db

# Local demo/runtime switches
LOCAL_DEMO_MODE=0
LOCAL_AUTH_BYPASS=true
LOCAL_DEMO_AUTOTRADE_LOOP=false
AI_ALLOW_DUMMY_PREDICTIONS=false
KIS_REAL_TRADING_ENABLED=false

# Runtime
APP_ENV=local
DEMO_MODE=false
DEMO_AUTOTRADE_LOOP=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Databases started by docker-compose.yml
DATABASE_URL=postgresql://trader:traderpass@localhost:5432/trading
MARKET_DB_URL=postgresql://trader:traderpass@localhost:5433/market_data
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123

# Google OAuth callback
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# KIS
KIS_MOCK=true
KIS_MARKET_DATA_REAL=true

# AI/report integrations
AI_SERVER_API_KEY=dev-ai-key

# Google 로그인 후 프론트 콜백으로 리다이렉트 (미설정이면 JSON 응답). 예: http://localhost:3000/auth/google/callback
FRONTEND_GOOGLE_CALLBACK_URL=
# AI 예측이 이 분(minute)보다 오래되면 매매 판단에서 HOLD/신뢰도 0 처리 (0=검사 안 함)
AI_PRED_MAX_AGE_MIN=30
